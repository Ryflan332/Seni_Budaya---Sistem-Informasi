        <!-- Hubungkan Aksi Katalog ke Logic Tier -->
        <mxCell id="e_filter1" value="Ketik / Filter" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C05621;strokeWidth=2;fontColor=#C05621;fontStyle=1;" edge="1" parent="1" source="u_katalog_action" target="c_search_engine">
