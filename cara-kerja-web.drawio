          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_match_yes" value="YA (Cocok)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4CAF50;strokeWidth=2;fontColor=#2E7D32;fontStyle=1;" edge="1" parent="1" source="c_check_match" target="p_show_card">
          <mxGeometry relative="1" as="geometry" />
