  <diagram id="cara-kerja-sistem-budaya" name="Arsitektur & Cara Kerja Web Budaya Indonesia">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1200" background="#FBF7EE" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================= JUDUL UTAMA ================= -->
        <mxCell id="title" value="DIAGRAM ALUR &amp; CARA KERJA SISTEM INFORMASI BUDAYA INDONESIA" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#2B2118;fontFamily=Georgia;" vertex="1" parent="1">
          <mxGeometry x="360" y="20" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Model Interaksi Multi-Page Application (MPA), Client-Side Search Engine, Filter Wilayah, &amp; Modal Lightbox" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#6B5E51;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="360" y="60" width="1200" height="20" as="geometry" />
        </mxCell>

        <!-- ================= SWIMLANES ================= -->
        <!-- Lane 1: User Action Tier -->
        <mxCell id="lane1" value="USER INTERACTION TIER (PENGGUNA &amp; NAVIGASI)" style="swimlane;startSize=40;fillColor=#F4ECE0;strokeColor=#C05621;strokeWidth=2;fontStyle=1;fontColor=#2B2118;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="480" height="1020" as="geometry" />
        </mxCell>

        <!-- Lane 2: Logic Controller Tier -->
        <mxCell id="lane2" value="CONTROLLER &amp; LOGIC TIER (JAVASCRIPT / EVENT ENGINE)" style="swimlane;startSize=40;fillColor=#FFFFFF;strokeColor=#231A14;strokeWidth=2;fontStyle=1;fontColor=#2B2118;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="540" y="110" width="760" height="1020" as="geometry" />
        </mxCell>

        <!-- Lane 3: Presentation Tier -->
        <mxCell id="lane3" value="VIEW &amp; DETAIL DESTINATION TIER (DOM / HALAMAN DETAIL)" style="swimlane;startSize=40;fillColor=#FDFBF7;strokeColor=#C05621;strokeWidth=2;fontStyle=1;fontColor=#2B2118;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1320" y="110" width="560" height="1020" as="geometry" />
        </mxCell>

        <!-- ================= NODE DALAM LANE 1 (USER ACTION) ================= -->
        <mxCell id="u_start" value="Mulai: Buka Browser&amp;nbsp;&#xa;URL: index.html" style="ellipse;whiteSpace=wrap;html=1;fillColor=#231A14;strokeColor=#231A14;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="lane1">
          <mxGeometry x="140" y="60" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="u_home" value="Halaman Beranda&#xa;(Hero Section, Statistik Budaya,&#xa;Cuplikan Khazanah Adat)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C05621;strokeWidth=1.5;fontColor=#2B2118;fontStyle=1;" vertex="1" parent="lane1">
          <mxGeometry x="130" y="140" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="u_nav_choice" value="Pilih Navigasi / Fitur?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#C05621;strokeColor=#9C4215;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="lane1">
          <mxGeometry x="145" y="230" width="170" height="80" as="geometry" />
        </mxCell>

        <mxCell id="u_ragam" value="ragam-warisan.html&#xa;(Pusat 4 Pilar Budaya)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C05621;strokeWidth=1.5;fontColor=#2B2118;fontStyle=1;" vertex="1" parent="lane1">
          <mxGeometry x="20" y="350" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="u_galeri" value="pages/galeri/index.html&#xa;(Galeri Dokumentasi Foto)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C05621;strokeWidth=1.5;fontColor=#2B2118;fontStyle=1;" vertex="1" parent="lane1">
          <mxGeometry x="270" y="350" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="u_katalog_select" value="Pilih Katalog Budaya:&#xa;• Seni Musik (seni-musik.html)&#xa;• Seni Tari (seni-tari.html)&#xa;• Rumah Adat (rumah-adat.html)&#xa;• Kuliner (makanan-tradisional.html)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#231A14;strokeColor=#231A14;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="lane1">
          <mxGeometry x="20" y="440" width="230" height="90" as="geometry" />
        </mxCell>

        <mxCell id="u_katalog_action" value="Aksi Pengguna di Katalog:&#xa;1. Ketik Kata Kunci Pencarian&#xa;2. Klik Tombol Filter Wilayah&#xa;3. Klik Ikon Bookmark/Favorit&#xa;4. Klik 'Jelajah Sejarah' (Detail)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FFFFFF;strokeColor=#C05621;strokeWidth=1.5;fontColor=#2B2118;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="lane1">
          <mxGeometry x="20" y="580" width="250" height="90" as="geometry" />
        </mxCell>

        <mxCell id="u_mobile" value="Klik Tombol Mobile Menu&#xa;(#mobileMenuBtn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B5E51;fontColor=#2B2118;" vertex="1" parent="lane1">
          <mxGeometry x="20" y="740" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="u_galeri_action" value="Aksi di Galeri:&#xa;• Klik Filter Tab Kategori&#xa;• Klik Foto (.lightbox-trigger)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FFFFFF;strokeColor=#C05621;strokeWidth=1.5;fontColor=#2B2118;fontStyle=1;" vertex="1" parent="lane1">
          <mxGeometry x="240" y="740" width="220" height="50" as="geometry" />
        </mxCell>

        <!-- ================= NODE DALAM LANE 2 (CONTROLLER & LOGIC TIER) ================= -->
        <mxCell id="c_dom" value="Event: DOMContentLoaded&#xa;js/main.js siap dieksekusi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#231A14;strokeColor=#231A14;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="lane2">
          <mxGeometry x="270" y="60" width="210" height="45" as="geometry" />
        </mxCell>

        <mxCell id="c_observer" value="IntersectionObserver&#xa;Deteksi .reveal-fade-up / .reveal-fade-in&#xa;saat elemen masuk viewport" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECE0;strokeColor=#C05621;strokeWidth=1.5;fontColor=#2B2118;" vertex="1" parent="lane2">
          <mxGeometry x="50" y="140" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Logika Search & Filter -->
        <mxCell id="c_search_engine" value="Fungsi: filterItems()&#xa;Ambil input query &amp; activeRegion&#xa;Query: searchInput.value.toLowerCase()&#xa;Region: data-region aktif" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C05621;strokeWidth=2;fontColor=#2B2118;fontStyle=1;" vertex="1" parent="lane2">
          <mxGeometry x="50" y="320" width="270" height="70" as="geometry" />
        </mxCell>

        <mxCell id="c_loop_card" value="Looping Tiap Kartu Budaya&#xa;(music-card / dance-card / house-card / food-card)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4ECE0;strokeColor=#6B5E51;fontColor=#2B2118;" vertex="1" parent="lane2">
          <mxGeometry x="50" y="420" width="270" height="40" as="geometry" />
        </mxCell>

        <mxCell id="c_check_match" value="Cocokkan:&#xa;(Region == 'all' || CardRegion == Region)&#xa;&amp;&amp;&#xa;(Title / Daerah / Deskripsi memuat Query?)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#C05621;strokeColor=#9C4215;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="lane2">
          <mxGeometry x="370" y="380" width="250" height="110" as="geometry" />
        </mxCell>

        <mxCell id="c_fav_engine" value="Handler: .favorite-btn Click&#xa;1. e.preventDefault() &amp; stopPropagation()&#xa;2. Cek apakah ada 'fa-regular'?&#xa;3. Toggle 'fa-solid text-terracotta'&#xa;4. Animasi scale-125 (200ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C05621;strokeWidth=1.5;fontColor=#2B2118;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="lane2">
          <mxGeometry x="50" y="550" width="270" height="90" as="geometry" />
        </mxCell>

        <!-- Logika Mobile Menu & Galeri Filter -->
        <mxCell id="c_mobile_logic" value="Handler Mobile Menu:&#xa;mobileMenu.classList.toggle('hidden')&#xa;Auto-close saat salah satu link diklik" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B5E51;fontColor=#2B2118;" vertex="1" parent="lane2">
          <mxGeometry x="50" y="690" width="260" height="55" as="geometry" />
        </mxCell>

        <mxCell id="c_gallery_filter" value="Handler: .gallery-filter-btn Click&#xa;1. Update active tab style (bg-earth)&#xa;2. Looping .gallery-item&#xa;3. Tampilkan item kategori terpilih (remove 'hidden')&#xa;4. Sembunyikan lainnya (add 'hidden')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C05621;strokeWidth=1.5;fontColor=#2B2118;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="lane2">
          <mxGeometry x="360" y="690" width="270" height="85" as="geometry" />
        </mxCell>

        <!-- Logika Lightbox -->
        <mxCell id="c_lightbox" value="Handler Modal Lightbox:&#xa;1. Buka: Ambil src &amp; caption foto&#xa;2. Set modalImage.src &amp; textCaption&#xa;3. Hapus class 'hidden', tambah 'flex active'&#xa;4. Listener Tutup: Klik X / Luar Modal / Escape Key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#231A14;strokeColor=#231A14;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="lane2">
          <mxGeometry x="360" y="810" width="290" height="95" as="geometry" />
        </mxCell>

        <!-- ================= NODE DALAM LANE 3 (PRESENTATION & DETAIL) ================= -->
        <mxCell id="p_scroll_active" value="Elemen Diberi Class 'active'&#xa;Efek Halus CSS: Opacity &amp; translateY(0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C05621;fontColor=#2B2118;" vertex="1" parent="lane3">
          <mxGeometry x="40" y="140" width="250" height="50" as="geometry" />
        </mxCell>

        <mxCell id="p_show_card" value="Set style.display = 'flex'&#xa;visibleCount++ (Kartu Ditampilkan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#2E7D32;fontStyle=1;" vertex="1" parent="lane3">
          <mxGeometry x="40" y="360" width="230" height="45" as="geometry" />
        </mxCell>

        <mxCell id="p_hide_card" value="Set style.display = 'none'&#xa;(Kartu Disembunyikan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#E91E63;strokeWidth=1.5;fontColor=#C2185B;fontStyle=1;" vertex="1" parent="lane3">
          <mxGeometry x="40" y="440" width="230" height="45" as="geometry" />
        </mxCell>

        <mxCell id="p_counter" value="Update Live Counter:&#xa;searchCounter.innerHTML =&#xa;'Menampilkan X dari Total Item'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C05621;fontColor=#2B2118;fontStyle=1;" vertex="1" parent="lane3">
          <mxGeometry x="300" y="360" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="p_empty_state" value="Jika visibleCount == 0:&#xa;Tampilkan State Kosong (#noResults)&#xa;dengan Kata Kunci Pencarian" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9800;fontColor=#E65100;fontStyle=1;" vertex="1" parent="lane3">
          <mxGeometry x="300" y="440" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="p_detail_page" value="Navigasi ke Halaman Detail Spesifik:&#xa;pages/seni-musik/[nama].html&#xa;pages/seni-tari/[nama].html&#xa;pages/rumah-adat/[nama].html&#xa;pages/makanan-tradisional/[nama].html&#xa;(Menampilkan Sejarah, Makna, dan Galeri)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#231A14;strokeColor=#231A14;fontColor=#FFFFFF;fontStyle=1;align=left;spacingLeft=15;" vertex="1" parent="lane3">
          <mxGeometry x="40" y="560" width="310" height="110" as="geometry" />
        </mxCell>

        <mxCell id="p_modal_view" value="Tampilan Fullscreen Modal Lightbox&#xa;Background Gelap Backdrop Blur&#xa;Foto Resolusi Penuh + Keterangan Adat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C05621;strokeWidth=2;fontColor=#2B2118;fontStyle=1;" vertex="1" parent="lane3">
          <mxGeometry x="40" y="810" width="260" height="70" as="geometry" />
        </mxCell>

