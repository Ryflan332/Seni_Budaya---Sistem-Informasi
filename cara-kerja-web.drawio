        <mxCell id="e_empty" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#FF9800;strokeWidth=1.5;" edge="1" parent="1" source="p_hide_card" target="p_empty_state">
