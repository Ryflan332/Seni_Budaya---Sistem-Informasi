        <mxCell id="g_close_opt" value="Kemudahan Menutup Tampilan Pop-up:&#xa;1. Klik Tombol 'X' (Silang)&#xa;2. Klik Area Gelap di Luar Foto&#xa;3. Tekan Tombol 'Esc' pada Keyboard&#xa;➔ Pengguna Kembali ke Tampilan Galeri" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#231A14;strokeWidth=1.5;fontColor=#2B2118;align=left;spacingLeft=12;" vertex="1" parent="sec5">
